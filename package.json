{
  "name": "discord-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "bun --env-file=.env.development src/main.ts",
    "dev:watch": "bun --env-file=.env.development --watch src/main.ts",
    "register": "bun --env-file=.env src/utils/command/register.ts",
    "register:dev": "bun --env-file=.env.development src/utils/command/register.ts",
    "unregister-commands": "bun --env-file=.env src/utils/command/unregister.ts",
    "unregister-commands:dev": "bun --env-file=.env.development src/utils/command/unregister.ts",
    "start": "bun --env-file=.env src/main.ts",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "prepare": "vp config",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check"
  },
  "dependencies": {
    "@discordjs/collection": "2.1.1",
    "discord.js": "14.26.4",
    "fuse.js": "^7.5.0",
    "google-auth-library": "^11.0.2",
    "pino": "9.7.0",
    "pino-pretty": "13.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "4.1.9"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
